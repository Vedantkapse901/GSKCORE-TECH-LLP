# Block access to sensitive files
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.sql$">
  Require all denied
</FilesMatch>

# No directory listings
Options -Indexes

# Allow CORS preflight to reach PHP even on hosts that intercept OPTIONS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} OPTIONS
  RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>
